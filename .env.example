# Copy to .env (never commit .env). Each partner runs MySQL locally.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tracker
MYSQL_PASSWORD=
MYSQL_DATABASE=security_tracker
# Website login password for north.demo / south.demo (12-256 characters, not your Atlas password).
DEMO_PASSWORD=
# Shared DevSandbox Atlas cluster. Replace <db_username> and <db_password>, including the angle brackets.
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@devsandbox.wmkyxxs.mongodb.net/
# Each partner uses their own Atlas database (security_tracker_john or Matt's) because
# both local MySQL databases start request IDs at 1 and notes are keyed by request ID.
MONGODB_DATABASE=security_tracker_john
PORT=3000
# Set COOKIE_SECURE=true only when serving over HTTPS.
